rules_version = '2';

/**
 * PHASE 3.2: Firestore Security Rules
 *
 * These rules ensure users can only access their own data
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Projects collection
    match /projects/{projectId} {
      // Users can read their own projects
      allow read: if isOwner(resource.data.userId);

      // Users can create new projects (they must set themselves as owner)
      allow create: if isAuthenticated() &&
                      request.resource.data.userId == request.auth.uid;

      // Users can update/delete their own projects
      allow update, delete: if isOwner(resource.data.userId);

      // Pages subcollection
      match /pages/{pageId} {
        allow read: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.userId);
        allow write: if isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.userId);
      }
    }

    // Public projects (optional feature)
    match /public_projects/{projectId} {
      // Anyone can read public projects
      allow read: if true;

      // Only owner can write
      allow write: if isOwner(resource.data.userId);
    }

    // User profiles
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);

      // Users can create/update their own profile
      allow write: if isOwner(userId);
    }
  }
}
